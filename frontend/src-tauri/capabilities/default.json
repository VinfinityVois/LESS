{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for LESS control and the auxiliary camera display",
  "windows": ["main", "less-camera-display"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close"
  ]
}
