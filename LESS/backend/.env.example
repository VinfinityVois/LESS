# Скопируйте в .env и измените значения
HOST=127.0.0.1
PORT=8000
DEBUG=true

SECRET_KEY=сгенерируйте-длинный-случайный-ключ-openssl-rand-hex-32

# Камера
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15

# Arduino (Windows: COM3, Linux: /dev/ttyUSB0 или /dev/ttyACM0)
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
