# Скопируйте в backend/.env. Для SECRET_KEY сгенерируйте случайное значение:
# python -c "import secrets; print(secrets.token_hex(32))"
HOST=127.0.0.1
PORT=8000
DEBUG=true

SECRET_KEY=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_SECRET

CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
JPEG_QUALITY=75

SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=1.0

AI_ANOMALY_WINDOW_MINUTES=60
AI_FAILED_ATTEMPTS_THRESHOLD=5
