# Generate a unique 32-byte key for each installation; never commit real keys.
SECRET_KEY=
AUDIT_HMAC_KEY=
CONTROLLER_HMAC_KEY=
CONTROLLER_ID=LESS-DOOR-01
CONTROLLER_ACK_TIMEOUT=4.0

# Experimental ML cohort baseline; values are not model-quality guarantees.
AI_ML_LOOKBACK_DAYS=30
AI_ML_MIN_SUBJECTS=12
AI_ML_MIN_EVENTS_PER_SUBJECT=3

# Optional fingerprint device pin. Leave empty until a vendor adapter and reader are installed.
FINGERPRINT_DEVICE_ID=

# Optional local Ollama-compatible assistant. Disabled by default; loopback only.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:3b
